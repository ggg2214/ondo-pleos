<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Connect 공식 SDK 최소 권한 선언 (호출하는 API 도메인에 해당하는 권한만 선언) -->
    <!-- 1) Vehicle SDK: 기어(P/R/N/D), 비상등/방향지시등, 주행속도, 안전 경고등, CRN 확인 -->
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- 2) FusedLocation SDK & NaviHelper SDK -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- 3) 음성 제보(STT) 및 V2X 중계 네트워크 통신 (일반 에뮬레이터 위치 폴백 포함) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 차량용 인포테인먼트(IVI) 및 일반 에뮬레이터 호환 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.OndoPleos">

        <!-- Pleos Playground 프로젝트 등록 및 데브박스/에뮬레이터(CRN) 바인딩 메타데이터 -->
        <meta-data
            android:name="ai.pleos.playground.PROJECT_ID"
            android:value="${pleosProjectId}" />
        <meta-data
            android:name="ai.pleos.playground.CLIENT_ID"
            android:value="${pleosClientId}" />
        <meta-data
            android:name="ai.pleos.playground.DEVBOX_CRN"
            android:value="${pleosDevboxCrn}" />
        <meta-data
            android:name="ai.pleos.sdk.SCOPES"
            android:value="vehicle.state,navi.helper" />

        <!-- Pleos Window Policy: 1:1 Portrait 분할 창 및 2:0/2:1 Landscape 전체 창 모두 대응 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">

            <!-- AAOS 주행 중 운전 부주의 최적화(Distraction Optimization) 선언: 비디오/키보드 미사용 + CarUxRestrictions 준수 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Gleo Interface 공식 Action Filter (assets/schema.json 의 actionCalls 함수명과 1:1 일치) -->
            <intent-filter>
                <action android:name="REPORT_HIGHWAY_INCIDENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="CHECK_AHEAD_HAZARDS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- 보조 테스트용 커스텀 URI 딥링크 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="ondo"
                    android:host="emergency-report" />
            </intent-filter>
        </activity>
    </application>

</manifest>
